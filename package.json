{
  "name": "@local/dsh-session-purge",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Right-click a sidebar session to delete its log, projection cache and workspace entry, open its working directory, or hide every ungrouped session.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
